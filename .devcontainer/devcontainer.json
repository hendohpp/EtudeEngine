{
  "name": "Debian Development Environment",
  "build": {
    "dockerfile": "../.devcontainer/Dockerfile",
    "context": ".." // what docker can access when building image
  },
  "remoteUser": "vscode",
  "customizations": {
    "vscode": {
      "settings": {
        "python.defaultInterpreterPath": "/home/vscode/venv/bin/python",
        "terminal.integrated.defaultProfile.linux": "bash",
        "latex-workshop.latex.autoBuild.run": "onSave",
        "latex-workshop.latex.recipes": [
          {
            "name": "pdflatex -> bibtex -> pdflatex*2",
            "tools": [
              "pdflatex",
              "bibtex",
              "pdflatex",
              "pdflatex"
            ]
          }
        ],
        "latex-workshop.latex.tools": [
          {
            "name": "pdflatex",
            "command": "pdflatex",
            "args": [
              "-synctex=1",
              "-interaction=nonstopmode",
              "-file-line-error",
              "%DOC%"
            ]
          },
          {
            "name": "bibtex",
            "command": "bibtex",
            "args": [
              "%DOCFILE%"
            ]
          }
        ]
      },
      "extensions": [
        "ms-vscode.cpptools-extension-pack@1.5.1",
        "ms-python.python@2026.4.0",
        "ms-python.vscode-pylance@2026.4.1",
        "myriad-dreamin.tinymist@0.15.8",
        "James-Yu.latex-workshop@10.10.0",
        "github.vscode-github-actions@0.32.3",
        "tamasfe.even-better-toml@0.21.2",
        "ms-azuretools.vscode-containers@2.5.2"
      ]
    }
  }
}